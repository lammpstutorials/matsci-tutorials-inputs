# LAMMPS Input File
# Licensed under CC BY 4.0
# A Set of Materials-Science Tutorials for the LAMMPS Simulation Package
# Tutorial 14 (visualization): render the molten core at the cascade peak.
# Reads peak.lammpstrj (written by cascade.lmp at ~0.28 ps, the moment of maximum
# disorder), selects the atoms that have been knocked off their lattice sites,
# and wraps that disordered region in a translucent surface with
# fix graphics/chunk (an alpha-shape hull around the cluster of atoms).

units        metal
atom_style   atomic
atom_modify  map array
boundary     p p p

variable     a0 equal 2.8553
lattice      bcc ${a0}
region       box block 0 30 0 30 0 30 open 4
create_box   3 box
mass         1 55.845
mass         2 55.845
mass         3 55.845
# no forces are needed for a static render, so use pair_style zero
pair_style   zero 5.0
pair_coeff   * *

# load the peak-damage atom positions and place them on the iron color slot
read_dump    peak.lammpstrj 320 x y z vx vy vz box no add yes
group        iron type 1
set          group iron type 3

# distance of each atom from its nearest lattice site (Wigner-Seitz)
compute      fr all frenkel
compute      ke all ke/atom


# select all "hot" atoms
variable     hot atom "c_ke > 0.5"
variable     acol atom log(c_ke)

fix          spheres all graphics/objects 1 &
                  sphere 1 80.0 10.0 5.0 3.0 &
                  sphere 2 80.0 10.0 15.0 3.0

fix          label   all graphics/labels 1 &
                text "Vacancy" 80.0 25 6 size 48  fontcolor black &
                text "    Interstitial" 80.0 25 16 size 48 fontcolor black

run          0 post no
group        core variable hot

write_dump   core image peak.png v_acol type  center s 0.5 0.5 0.5  adiam 3.0 &
             compute fr type 0 2 fix spheres type 1 0 fix label type 0 0   &
             view 75 10 zoom 1.4 size 1200 1200                 &
             shiny 0.2 fsaa yes ssao yes 9988 0.6 box yes 0.02  &
             modify backcolor white boxcolor midnightblue       &
             adiam * 2.5  color map2 0.342 0.062 0.429 &
                          color map3 0.736 0.216 0.330 &
             amap -0.5 1 cf 0.0 3 min map2 0.5 map3 max pink   &
             acolor 1 steelblue acolor 2 darkgoldenrod fcolor label black
