# LAMMPS Input File
# Licensed under CC BY 4.0
# A Set of Materials-Science Tutorials for the LAMMPS Simulation Package: 2. Materials Science
# By Simon Gravelle, Mark A. Tschopp, Jacob R. Gissinger, and Axel Kohlmeyer
# Tutorial 1: Generate figures. Use the "Run->Set Variables dialog to change "o" to 0.25

variable o   index 0.0

units metal
lattice fcc 4.049  origin $o $o $o
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box

pair_style eam/alloy
pair_coeff * * Al_zhou.eam.alloy Al
run 0 post no

write_dump  all image metals-fcc-${o}.png element type &
      size 1200 1200  view 60 -40  center s 0.47 0.47 0.5 &
      zoom 1.24 box yes 0.03 shiny 0.4 fsaa yes &
      modify boxcolor midnightblue backcolor white gamma 0.7 &
      specular wide metal 0.75 element Al adiam 1 2.6
